{
  "start": "main",
  "nodes": {
    "main": {
      "text": "What is it, @player?",
      "options": [
        {
          "text": "Follow me.",
          "if": {
            "all": [
              {
                "owner": true
              },
              {
                "not": {
                  "mode": "follow"
                }
              }
            ]
          },
          "actions": [
            {
              "order": "follow"
            }
          ]
        },
        {
          "text": "Wait here.",
          "if": {
            "all": [
              {
                "owner": true
              },
              {
                "not": {
                  "mode": "wait"
                }
              }
            ]
          },
          "actions": [
            {
              "order": "wait"
            }
          ]
        },
        {
          "text": "Guard this place.",
          "if": {
            "all": [
              {
                "owner": true
              },
              {
                "not": {
                  "mode": "guard"
                }
              }
            ]
          },
          "actions": [
            {
              "order": "guard"
            }
          ]
        },
        {
          "text": "Go about your day.",
          "if": {
            "all": [
              {
                "owner": true
              },
              {
                "routine": true
              },
              {
                "not": {
                  "mode": "live"
                }
              }
            ]
          },
          "actions": [
            {
              "order": "live"
            }
          ]
        },
        {
          "text": "How are you?",
          "actions": [
            {
              "mind": true
            }
          ]
        },
        {
          "text": "What are you good at?",
          "actions": [
            {
              "skills": true
            }
          ]
        },
        {
          "text": "Have an apple.",
          "if": {
            "item": "minecraft:apple"
          },
          "actions": [
            {
              "take": "minecraft:apple"
            },
            {
              "feel": "gift"
            }
          ],
          "goto": "thanks"
        },
        {
          "text": "I'm sorry.",
          "if": {
            "all": [
              {
                "not": {
                  "any": [
                    {
                      "mood": "calm"
                    },
                    {
                      "mood": "happy"
                    }
                  ]
                }
              },
              {
                "fault": true
              }
            ]
          },
          "actions": [
            {
              "feel": "apology"
            }
          ],
          "goto": "sorry"
        },
        {
          "text": "Who upset you?",
          "if": {
            "all": [
              {
                "not": {
                  "any": [
                    {
                      "mood": "calm"
                    },
                    {
                      "mood": "happy"
                    }
                  ]
                }
              },
              {
                "fault": false
              }
            ]
          },
          "goto": "not_you"
        },
        {
          "text": "Well done, @npc!",
          "if": {
            "owner": true
          },
          "actions": [
            {
              "feel": "praise"
            }
          ]
        },
        {
          "text": "Here, eat something.",
          "if": {
            "hungry": true
          },
          "actions": [
            {
              "feed": true
            }
          ]
        },
        {
          "text": "How's your family?",
          "if": {
            "family": true
          },
          "actions": [
            {
              "family": true
            }
          ]
        },
        {
          "text": "Just between us...",
          "if": {
            "stage": "acquaintance"
          },
          "goto": "us"
        },
        {
          "text": "What's on today?",
          "if": {
            "event": "any"
          },
          "goto": "event_today"
        },
        {
          "text": "Heard any news?",
          "actions": [
            {
              "news": true
            }
          ]
        },
        {
          "text": "Need any help?",
          "actions": [
            {
              "quests": [
                "projectfelix:apples",
                "projectfelix:zombies",
                "projectfelix:walk"
              ]
            }
          ]
        },
        {
          "text": "Something else...",
          "goto": "more"
        },
        {
          "text": "Back to the board.",
          "if": {
            "in_game": true
          },
          "actions": [
            {
              "open_game": true
            }
          ]
        },
        {
          "text": "Take the other seat.",
          "if": {
            "all": [
              {
                "game": "waiting"
              },
              {
                "in_game": false
              }
            ]
          },
          "actions": [
            {
              "join_game": true
            }
          ]
        },
        {
          "text": "Let me watch.",
          "if": {
            "all": [
              {
                "game": "playing"
              },
              {
                "in_game": false
              }
            ]
          },
          "actions": [
            {
              "open_game": true
            }
          ]
        },
        {
          "text": "Bye."
        }
      ]
    },
    "games": {
      "text": "What shall we play? I can play myself, or keep the board for you and a friend.",
      "options": [
        {
          "text": "Chess, against you.",
          "actions": [
            {
              "game": "chess",
              "vs": "npc"
            }
          ]
        },
        {
          "text": "Draughts, against you.",
          "actions": [
            {
              "game": "checkers",
              "vs": "npc"
            }
          ]
        },
        {
          "text": "Chess, with a friend.",
          "actions": [
            {
              "game": "chess",
              "vs": "player"
            }
          ]
        },
        {
          "text": "Draughts, with a friend.",
          "actions": [
            {
              "game": "checkers",
              "vs": "player"
            }
          ]
        },
        {
          "text": "Not now.",
          "goto": "main"
        }
      ]
    },
    "sports": {
      "text": "Sure! Stand where I put you and watch the ball. Left, right, or smash it when it comes high.",
      "options": [
        {
          "text": "Table tennis.",
          "actions": [
            {
              "sport": "table_tennis"
            }
          ]
        },
        {
          "text": "Tennis.",
          "actions": [
            {
              "sport": "tennis"
            }
          ]
        },
        {
          "text": "Basketball.",
          "actions": [
            {
              "sport": "basketball"
            }
          ]
        },
        {
          "text": "Not now.",
          "goto": "main"
        }
      ]
    },
    "about": {
      "text": [
        "I'm @npc. I walk where you walk and wait where you tell me to.",
        "Ask me to guard a place and nothing hostile gets near it."
      ],
      "options": [
        {
          "text": "Good to know.",
          "goto": "more"
        }
      ]
    },
    "gift": {
      "text": "Here, take these. I picked them on the way.",
      "animation": "animation.felix.wave",
      "actions": [
        {
          "give": "minecraft:apple",
          "count": 3
        },
        {
          "tag": "felix_gift"
        },
        {
          "sound": "minecraft:entity.item.pickup"
        }
      ],
      "options": [
        {
          "text": "Thanks!",
          "goto": "more"
        }
      ]
    },
    "feel_fine": {
      "text": "I'm fine, thanks for asking.",
      "options": [
        {
          "text": "Something else...",
          "goto": "main"
        },
        {
          "text": "Bye."
        }
      ]
    },
    "feel_bad": {
      "text": [
        "Not great, @player. Not great at all.",
        "Someone hurt a friend of mine. Or me."
      ],
      "options": [
        {
          "text": "Something else...",
          "goto": "main"
        },
        {
          "text": "Bye."
        }
      ]
    },
    "thanks": {
      "text": "For me? Thank you!",
      "options": [
        {
          "text": "Something else...",
          "goto": "main"
        },
        {
          "text": "Bye."
        }
      ]
    },
    "sorry": {
      "text": "...All right. Let's forget it.",
      "options": [
        {
          "text": "Something else...",
          "goto": "main"
        },
        {
          "text": "Bye."
        }
      ]
    },
    "more": {
      "text": "Sure, @player. What is it?",
      "options": [
        {
          "text": "Who are you?",
          "goto": "about"
        },
        {
          "text": "Got anything for me?",
          "if": {
            "not": {
              "tag": "felix_gift"
            }
          },
          "goto": "gift"
        },
        {
          "text": "Say hi!",
          "actions": [
            {
              "animation": "animation.felix.wave"
            }
          ]
        },
        {
          "text": "Hold still, I'll animate you.",
          "if": {
            "owner": true
          },
          "actions": [
            {
              "edit_animation": true
            }
          ]
        },
        {
          "text": "Show me a chess game.",
          "if": {
            "game": "none"
          },
          "actions": [
            {
              "scene": "projectfelix:chess"
            }
          ]
        },
        {
          "text": "Let's play.",
          "if": {
            "game": "none"
          },
          "goto": "games"
        },
        {
          "text": "Fancy a ball game?",
          "if": {
            "game": "none"
          },
          "goto": "sports"
        },
        {
          "text": "Live here.",
          "if": {
            "owner": true
          },
          "actions": [
            {
              "place": "home"
            }
          ],
          "goto": "placed"
        },
        {
          "text": "Work here.",
          "if": {
            "owner": true
          },
          "actions": [
            {
              "place": "work"
            }
          ],
          "goto": "placed"
        },
        {
          "text": "Keep your things here.",
          "if": {
            "owner": true
          },
          "actions": [
            {
              "place": "chest"
            }
          ],
          "goto": "placed"
        },
        {
          "text": "Let's meet here.",
          "if": {
            "owner": true
          },
          "actions": [
            {
              "place": "meet"
            }
          ],
          "goto": "placed"
        },
        {
          "text": "Do you sell anything?",
          "actions": [
            {
              "shop": true
            }
          ]
        },
        {
          "text": "Take this.",
          "if": {
            "owner": true
          },
          "actions": [
            {
              "gear": "take"
            }
          ]
        },
        {
          "text": "Give me back your gear.",
          "if": {
            "owner": true
          },
          "actions": [
            {
              "gear": "return"
            }
          ]
        },
        {
          "text": "How strong are you?",
          "actions": [
            {
              "stats": true
            }
          ]
        },
        {
          "text": "Never mind.",
          "goto": "main"
        }
      ]
    },
    "placed": {
      "text": "Got it. I'll remember this place.",
      "options": [
        {
          "text": "Something else...",
          "goto": "main"
        },
        {
          "text": "Bye."
        }
      ]
    },
    "not_you": {
      "text": "It's not you, @player. @upset_by can say sorry, not you.",
      "options": [
        {
          "text": "Something else...",
          "goto": "main"
        },
        {
          "text": "Bye."
        }
      ]
    },
    "event_today": {
      "text": "It's the @event, @player! Everyone's here. Come and join us.",
      "options": [
        {
          "text": "Something else...",
          "goto": "main"
        },
        {
          "text": "Bye."
        }
      ]
    },
    "us": {
      "text": "Yes, @player?",
      "options": [
        {
          "text": "I brought you something.",
          "actions": [
            {
              "gift": true
            }
          ]
        },
        {
          "text": "What do you like?",
          "actions": [
            {
              "tastes": true
            }
          ]
        },
        {
          "text": "Remember when...?",
          "if": {
            "stage": "friend"
          },
          "actions": [
            {
              "reminisce": true
            }
          ]
        },
        {
          "text": "Would you go out with me?",
          "if": {
            "all": [
              {
                "stage": "close"
              },
              {
                "romance": "none"
              }
            ]
          },
          "actions": [
            {
              "ask_out": true
            }
          ]
        },
        {
          "text": "Will you marry me?",
          "if": {
            "romance": "sweetheart"
          },
          "actions": [
            {
              "propose": true
            }
          ]
        },
        {
          "text": "Come live with me, here.",
          "if": {
            "romance": "partner"
          },
          "actions": [
            {
              "place": "home"
            }
          ],
          "goto": "moved_in"
        },
        {
          "text": "I think we should part ways.",
          "if": {
            "any": [
              {
                "romance": "sweetheart"
              },
              {
                "romance": "partner"
              }
            ]
          },
          "actions": [
            {
              "part": true
            }
          ]
        },
        {
          "text": "Something else...",
          "goto": "main"
        }
      ]
    },
    "moved_in": {
      "text": "Home is wherever you are, @player.",
      "options": [
        {
          "text": "Something else...",
          "goto": "main"
        },
        {
          "text": "Bye."
        }
      ]
    }
  }
}
