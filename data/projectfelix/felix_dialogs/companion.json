{
  "start": "main",
  "nodes": {
    "main": {
      "text": "What is it, @player?",
      "options": [
        { "text": "Follow me.", "if": { "all": [ { "owner": true }, { "not": { "mode": "follow" } } ] }, "actions": [ { "order": "follow" } ] },
        { "text": "Wait here.", "if": { "all": [ { "owner": true }, { "not": { "mode": "wait" } } ] }, "actions": [ { "order": "wait" } ] },
        { "text": "Guard this place.", "if": { "all": [ { "owner": true }, { "not": { "mode": "guard" } } ] }, "actions": [ { "order": "guard" } ] },
        { "text": "Who are you?", "goto": "about" },
        { "text": "Got anything for me?", "if": { "not": { "tag": "felix_gift" } }, "goto": "gift" },
        { "text": "Say hi!", "actions": [ { "animation": "animation.felix.wave" } ] },
        { "text": "Show me a chess game.", "if": { "game": "none" }, "actions": [ { "scene": "projectfelix:chess" } ] },
        { "text": "Let's play.", "if": { "game": "none" }, "goto": "games" },
        { "text": "Fancy a ball game?", "if": { "game": "none" }, "goto": "sports" },
        { "text": "Back to the board.", "if": { "in_game": true }, "actions": [ { "open_game": true } ] },
        { "text": "Take the other seat.", "if": { "all": [ { "game": "waiting" }, { "in_game": false } ] }, "actions": [ { "join_game": true } ] },
        { "text": "Let me watch.", "if": { "all": [ { "game": "playing" }, { "in_game": false } ] }, "actions": [ { "open_game": true } ] },
        { "text": "Bye." }
      ]
    },
    "games": {
      "text": "What shall we play? I can play myself, or keep the board for you and a friend.",
      "options": [
        { "text": "Chess, against you.", "actions": [ { "game": "chess", "vs": "npc" } ] },
        { "text": "Draughts, against you.", "actions": [ { "game": "checkers", "vs": "npc" } ] },
        { "text": "Chess, with a friend.", "actions": [ { "game": "chess", "vs": "player" } ] },
        { "text": "Draughts, with a friend.", "actions": [ { "game": "checkers", "vs": "player" } ] },
        { "text": "Not now.", "goto": "main" }
      ]
    },
    "sports": {
      "text": "Sure! Stand where I put you and watch the ball. Left, right, or smash it when it comes high.",
      "options": [
        { "text": "Table tennis.", "actions": [ { "sport": "table_tennis" } ] },
        { "text": "Tennis.", "actions": [ { "sport": "tennis" } ] },
        { "text": "Basketball.", "actions": [ { "sport": "basketball" } ] },
        { "text": "Not now.", "goto": "main" }
      ]
    },
    "about": {
      "text": [ "I'm @npc. I walk where you walk and wait where you tell me to.", "Ask me to guard a place and nothing hostile gets near it." ],
      "options": [ { "text": "Good to know.", "goto": "main" } ]
    },
    "gift": {
      "text": "Here, take these. I picked them on the way.",
      "animation": "animation.felix.wave",
      "actions": [ { "give": "minecraft:apple", "count": 3 }, { "tag": "felix_gift" }, { "sound": "minecraft:entity.item.pickup" } ],
      "options": [ { "text": "Thanks!", "goto": "main" } ]
    }
  }
}
