{
	"format_version": "1.8.0",
	"animations": {
		"animation.felix.idle": {
			"loop": true,
			"animation_length": 4,
			"bones": {
				"body": {
					"scale": {
						"0.0": { "post": [1, 1, 1], "lerp_mode": "catmullrom" },
						"2.0": { "post": [1.02, 1.01, 1.04], "lerp_mode": "catmullrom" },
						"4.0": { "post": [1, 1, 1], "lerp_mode": "catmullrom" }
					}
				},
				"rightArm": {
					"rotation": ["math.sin(q.anim_time * 90) * 3", 0, "2 + math.sin(q.anim_time * 90) * 2"]
				},
				"leftArm": {
					"rotation": ["-math.sin(q.anim_time * 90) * 3", 0, "-2 - math.sin(q.anim_time * 90) * 2"]
				},
				"hat": {
					"rotation": {
						"0.0": [0, 0, 0],
						"1.5": { "pre": [0, 0, 0], "post": [0, 0, 4] },
						"3.0": { "pre": [0, 0, 4], "post": [0, 0, 0] }
					}
				}
			}
		},
		"animation.felix.walk": {
			"loop": true,
			"animation_length": 1,
			"bones": {
				"rightLeg": {
					"rotation": {
						"0.0": { "post": [30, 0, 0], "lerp_mode": "catmullrom" },
						"0.5": { "post": [-30, 0, 0], "lerp_mode": "catmullrom" },
						"1.0": { "post": [30, 0, 0], "lerp_mode": "catmullrom" }
					}
				},
				"leftLeg": {
					"rotation": {
						"0.0": { "post": [-30, 0, 0], "lerp_mode": "catmullrom" },
						"0.5": { "post": [30, 0, 0], "lerp_mode": "catmullrom" },
						"1.0": { "post": [-30, 0, 0], "lerp_mode": "catmullrom" }
					}
				},
				"rightArm": {
					"rotation": {
						"0.0": { "post": [-25, 0, 2], "lerp_mode": "catmullrom" },
						"0.5": { "post": [25, 0, 2], "lerp_mode": "catmullrom" },
						"1.0": { "post": [-25, 0, 2], "lerp_mode": "catmullrom" }
					}
				},
				"leftArm": {
					"rotation": {
						"0.0": { "post": [25, 0, -2], "lerp_mode": "catmullrom" },
						"0.5": { "post": [-25, 0, -2], "lerp_mode": "catmullrom" },
						"1.0": { "post": [25, 0, -2], "lerp_mode": "catmullrom" }
					}
				},
				"body": {
					"position": [0, "math.abs(math.sin(q.anim_time * 360)) * 0.5", 0]
				}
			},
			"sound_effects": {
				"0.25": { "effect": "block.grass.step" },
				"0.75": { "effect": "block.grass.step" }
			}
		},
		"animation.felix.wave": {
			"loop": false,
			"animation_length": 2.5,
			"bones": {
				"rightArm": {
					"rotation": {
						"0.0": [0, 0, 0],
						"0.3": { "vector": [0, 0, 150], "easing": "easeOutBack" },
						"0.6": { "post": [0, 0, 170], "lerp_mode": "catmullrom" },
						"0.9": { "post": [0, 0, 140], "lerp_mode": "catmullrom" },
						"1.2": { "post": [0, 0, 170], "lerp_mode": "catmullrom" },
						"1.5": { "post": [0, 0, 140], "lerp_mode": "catmullrom" },
						"1.8": { "post": [0, 0, 160], "lerp_mode": "catmullrom" },
						"2.5": { "vector": [0, 0, 0], "easing": "easeInOutSine" }
					}
				},
				"head": {
					"rotation": {
						"0.0": [0, 0, 0],
						"0.4": [0, 0, -8],
						"2.0": [0, 0, -8],
						"2.5": [0, 0, 0]
					}
				}
			},
			"sound_effects": {
				"0.3": { "effect": "entity.villager.yes" }
			},
			"particle_effects": {
				"0.6": { "effect": "minecraft:heart", "locator": "hand" },
				"1.2": { "effect": "minecraft:heart", "locator": "hand" },
				"1.8": { "effect": "minecraft:note", "locator": "hand" }
			},
			"timeline": {
				"2.5": "v.waves = v.waves + 1;"
			}
		}
	}
}
